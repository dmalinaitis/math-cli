{
  "name": "math-cli",
  "version": "1.0.0",
  "description": "A maths chat for the terminal that renders LaTeX as real typeset equations — Claude or local models via LM Studio",
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "spike": "tsx src/spike.ts",
    "render": "tsx src/render-test.ts"
  },
  "keywords": [
    "math",
    "latex",
    "mathjax",
    "terminal",
    "cli",
    "claude",
    "lm-studio",
    "wezterm"
  ],
  "author": "dmalinaitis",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@resvg/resvg-js": "^2.6.2",
    "mathjax-full": "^3.2.1",
    "openai": "^7.27.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "mathcli": "bin/mathcli.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
